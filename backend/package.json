{
  "name": "neurotalento-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --watch .env --ext js,json,env --delay 300ms src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "test": "node --test",
    "db:check": "node scripts/check-db.js",
    "db:deploy:neon": "node scripts/neon-migrate.js",
    "test:live": "node scripts/smoke.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-validator": "^7.2.1",
    "google-auth-library": "^11.3.4",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "6.19.0"
  }
}
